# Base URL of the THE Fulfillment backend (Go/Gin). Business routes use /api.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8090

# Public URL of the system, used by the install QR at /install. Defaults to the
# production domain even in dev, so a QR printed from a dev machine still works.
# Override only when testing the install flow against a local server.
# NUXT_PUBLIC_APP_BASE_URL=http://192.168.1.10:3001
